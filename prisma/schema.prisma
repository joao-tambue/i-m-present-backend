generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COORDINATOR
  EMPLOYEE
}

enum Area {
  DEV_FULLSTACK
  AI_ENGINEER
  FRONTEND_ENGINEER
  BACKEND_ENGINEER
  DEVOPS
  INFRASTRUCTURE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  INCOMPLETE
}

enum QRCodeStatus {
  ACTIVE
  REVOKED
}

model Coordinator {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  password  String
  role      Role     @default(COORDINATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coordinators")
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  area      Area
  password  String
  role      Role     @default(EMPLOYEE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qrCode    EmployeeQRCode?
  attendance AttendanceRecord[]
  schedule  workSchedule?

  @@map("employees")
}

model EmployeeQRCode {
  id        String   @id @default(cuid())
  code      String   @unique @default(uuid())
  status    QRCodeStatus @default(ACTIVE)
  employeeId String  @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  issuedAt  DateTime @default(now())
  revokedAt DateTime?

  @@map("employee_qr_codes")
}

model AttendanceRecord {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  checkInAt  DateTime?
  checkOutAt DateTime?
  checkInMethod String? // "qr_code" ou "manual"
  checkOutMethod String? // "qr_code" ou "manual"
  status     AttendanceStatus @default(INCOMPLETE)
  lateMinutes Int? @default(0) // Minutos de atraso, se aplicável
  workedMinutes Int?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("attendance_records")
}

model workSchedule {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  expectedCheckIn String
  expectedCheckOut String
  lateToleranceMinutes Int @default(15) // Tolerância de atraso em minutos
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("work_schedules")
}

model Event {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  startsAt    DateTime
  description String?
  attendees   Attendee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Attendee {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  checkedIn Boolean  @default(false)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

